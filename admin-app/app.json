{
  "expo": {
    "name": "EASY CAR WASH Admin",
    "slug": "easy-car-wash-admin",
    "scheme": "easycarwashadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mn.easycarwash.admin"
    },
    "android": {
      "package": "mn.easycarwash.admin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "57ab1045-7c8a-4bd2-bb6a-530b7a8c7db4"
      }
    },
    "owner": "saylos"
  }
}
